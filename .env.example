# Where the relay listens. Default 127.0.0.1:8088.
RELAY_LISTEN=127.0.0.1:8088

# ---- Plugins (v0.98) ----
# Directory scanned for plugin .py files (each must export apply(ctx)).
# Defaults to <project root>/plugins. See src/relay/plugin.py.
# RELAY_PLUGINS_DIR=./plugins

# Path to the SQLite file. Relative paths are resolved from CWD.
RELAY_DB=./relay.db

# ---- Multi-upstream configuration ----
#
# PREFERRED (v0.8+): put your APIs / nodes in `upstreams.json` — it's
# pretty-printable, supports a per-node "note", and syntax errors are
# reported with a line number instead of silently mangling one long line.
# See upstreams.example.json. That file WINS over the env vars below.
# The server writes one for you (seeded from these vars) on first start.
RELAY_UPSTREAMS_FILE=./upstreams.json

# LEGACY: one JSON list per platform, used only when upstreams.json is
# missing or has no section for that platform. The matching
# `<PLATFORM>_ACTIVE` is used for traffic to that platform.
#
# Each entry: { "name": "<id>", "url": "<base>", "api_key": "<opt>",
#               "auth_header": "<opt, default x-api-key or authorization>" }
# When `api_key` is set, the relay REPLACES the client's auth header with
# this value (so a single key can be shared across many tools). The
# special sentinel value "auto" on the client side asks the relay to
# substitute its configured key; if no upstream key is configured the
# relay returns 503 with a clear error instead of forwarding "auto".
#
# Note: pydantic-settings reads one value per line, so keep the JSON
# on a single line. This is exactly the pain upstreams.json solves.

ANTHROPIC_UPSTREAMS=[{"name":"prod","url":"https://api.anthropic.com"},{"name":"minnimax","url":"https://minnimax.chat","api_key":"sk-...","auth_header":"x-api-key"}]
ANTHROPIC_ACTIVE=prod

OPENAI_UPSTREAMS=[{"name":"openai","url":"https://api.openai.com"}]
OPENAI_ACTIVE=openai

# ---- Legacy single-upstream (still honoured if *_UPSTREAMS is unset) ----
# ANTHROPIC_UPSTREAM=https://api.anthropic.com
# OPENAI_UPSTREAM=https://api.openai.com

# ---- Optional auth gate on the relay itself ----
# If set, every request must carry `Authorization: Bearer <value>` or
# `X-Relay-Token: <value>`. Leave blank for local development.
# RELAY_REQUIRE_AUTH_TOKEN=

# ---- Conversation storage (v0.4) ----
# Save per-request user/assistant message bodies to SQLite (drives the GUI
# detail popup + `/messages/search`). Costs ~1-2 MB per 100 conversations/day.
# Set to 0 to disable; historical DBs are not back-filled.
# RELAY_SAVE_MESSAGES=1

# ---- Quota monitor (v0.20) ----
# Seconds between utilization checks; 0 disables the background task.
# RELAY_QUOTA_CHECK_INTERVAL=60
# When the active upstream crosses RELAY_QUOTA_SWITCH_AT utilization, traffic
# moves to the least-utilized sibling. Auto-switch is OPT-IN (off by default):
# with it off the monitor only logs warnings. RELAY_AUTOSWITCH_POOL is a JSON
# list of upstream names allowed as switch targets (empty = all siblings).
# RELAY_QUOTA_AUTOSWITCH=0
# RELAY_QUOTA_SWITCH_AT=0.9
# RELAY_AUTOSWITCH_POOL=[]

# ---- GUI (relay-gui) ----
# RELAY_GUI_THEME=light            # "light" or "dark"
# RELAY_GUI_START_HIDDEN=0         # start minimized to tray (autostart mode)
# RELAY_GUI_SHOW_IO_MAP=0          # show the inbound↔outbound model map bar
# RELAY_GUI_LIVE_PANEL=0           # v0.89: open a second window streaming /live/stream
#                                  # events (per-call upstream, model, plain api_key,
#                                  # inbound↔outbound wire, live token counts,
#                                  # thinking/text/tool_use chunks). Setting page
#                                  # and topbar "实时流" button toggle the same flag.
#                                  # Default off — opens hidden, shown via UI.

# ---- Advanced switch (v0.11.18, experimental) ----
# NOTE: normally configured via the GUI and persisted in upstreams.json's
# top-level `advanced` section, NOT here. These env vars are read only as a
# fallback when upstreams.json has no such section.
# ADVANCED_SWITCH=0
# ADVANCED_WEAK_UPSTREAM=          # upstream + model for "weak" (cheap) traffic
# ADVANCED_WEAK_MODEL=
# ADVANCED_STRONG_UPSTREAM=        # upstream + model for "strong" (hard) traffic
# ADVANCED_STRONG_MODEL=
# ADVANCED_ANALYSIS_UPSTREAM=      # upstream + model for analysis requests
# ADVANCED_ANALYSIS_MODEL=
# ADVANCED_STRONG_TYPES=[]         # request types routed to the strong model
# ADVANCED_AGGRESSIVE=0            # true = ambiguous requests go strong
# ADVANCED_LEARNING=0              # reserved for future history-based routing