# RelayMeter 发布默认 .env 模板（v0.177）
#
# 用途：wheel/exe 首启 seed 到 %LOCALAPPDATA%\Relay\.env 时使用；
# 由 relay.config._seed_default_config() 复制到用户数据目录后立即
# 覆盖 / 任何账号级字段（API key / 上游 URL / quota）均为占位，**必须
# 在首次启动前补全**，否则中继无法路由任何请求。
#
# 修改建议：
#   1. 直接编辑本文件，保存后重启 GUI 生效。
#   2. 设置页所有「开关 / 数值 / 选档」调整后都会写回 %LOCALAPPDATA%\Relay\.env。
#
# ⚠ 不要把填了真 key 的 .env 提交进仓库 —— 这是发布标准，**不含**真实 API key。
# ⚠ 如果你是从 wheel/exe 装的，本文件首次启动后会在 %LOCALAPPDATA%\Relay\
#    复制出一份（路径见下面 RELAY_DB 旁的注释），后续以那份为准。

# ---- 监听地址（uvicorn 解析） ----
# 默认 127.0.0.1:8088。本机客户端直连。
RELAY_LISTEN=127.0.0.1:8088

# ---- 数据库与上游配置文件（绝对路径，避免 CWD 漂移） ----
# v0.9.1：移到 %LOCALAPPDATA%\Relay\ 防止开机启动后 CWD 不对导致找不到文件
# 打包发布：默认落在 %LOCALAPPDATA%\Relay\ 下；用户可改。
RELAY_DB=%LOCALAPPDATA%\Relay\relay.db
RELAY_UPSTREAMS_FILE=%LOCALAPPDATA%\Relay\upstreams.json

# ---- 账号级配置（上游 / API key）----
# 真 API key / URL 在 upstreams.json 里；这里留空做占位。
# ANTHROPIC_UPSTREAMS=[{"name":"default","url":"https://api.anthropic.com"}]
# ANTHROPIC_ACTIVE=default

# ---- GUI 偏好（v0.177 起：发布默认 = 用户日常偏好）----
# 主题："day" 暖白 / "light" 浅色 / "dark" 深色
RELAY_GUI_THEME=day
# 启动后隐藏窗口（缩到托盘）
RELAY_GUI_START_HIDDEN=0
# 内外转换显示（topbar 状态条右侧实时显示客户端→中继→上游模型映射）
RELAY_GUI_SHOW_IO_MAP=1
# 实时流侧栏（live panel）
RELAY_GUI_LIVE_PANEL=1
# 实时栏管理
RELAY_GUI_LIVE_PANEL_CONCURRENT=1
RELAY_GUI_LIVE_PANEL_MAX=3
RELAY_GUI_LIVE_PANEL_AUTO_EXTEND=1
RELAY_GUI_LIVE_PANEL_ALWAYS_ONE=0
# 悬浮球 + 置顶
RELAY_GUI_FLOAT_BALL=1
RELAY_GUI_FLOAT_BALL_TOPMOST=1
# 实时栏阶段感知 stale 超时（秒）
RELAY_LIVE_PANEL_THINKING_TIMEOUT=3.0
RELAY_LIVE_PANEL_GAP_TIMEOUT=7.0
RELAY_LIVE_PANEL_TEXT_TIMEOUT=5.0
RELAY_LIVE_PANEL_DONE_CLEAR_TIMEOUT=5.0
# 实时栏侧栏前端可调项
RELAY_GUI_LIVE_PANEL_TOOLS_CLEAR_TIMEOUT=5.0
RELAY_GUI_LIVE_PANEL_TOOLS_CAP=30
RELAY_GUI_LIVE_PANEL_EP_LIST_VH=30.0
RELAY_GUI_LIVE_PANEL_TOOLS_ALWAYS=0
RELAY_GUI_LIVE_PANEL_MIN_COLS=1
RELAY_GUI_LIVE_PANEL_LIST_FONT=medium
RELAY_GUI_PANEL_FRAMELESS=0

# ---- 保存消息原文与回复 ----
# 0 = 只留计数/时间戳，节省 DB 体积；1 = 完整保存请求体+组装响应（搜索会话用）
RELAY_SAVE_MESSAGES=1

# ---- 配额监控（quota_monitor）----
# 自动切换上游：默认 OFF（监控仍会打警告日志，不静默切走）
RELAY_QUOTA_AUTOSWITCH=0
# 切换阈值（剩余比例 1-quota_switch_at = 30% 时切换）；UI 不暴露，env 可覆盖
RELAY_QUOTA_SWITCH_AT=0.7
# 允许被自动接管的上游（空 = 全部）
# RELAY_AUTOSWITCH_POOL=["upstream-a","upstream-b"]

# ---- 完全透传模式 ----
PASSTHROUGH_MODE=0
RELAY_PASSTHROUGH_DB=%LOCALAPPDATA%\Relay\passthrough.db

# ---- 中继间鉴权（可选）----
# 留空 = 不需要鉴权；填了之后客户端必须带 X-Relay-Token: <value> 或 Authorization: Bearer <value>
RELAY_REQUIRE_AUTH_TOKEN=

# ---- 错误分析（v0.113o，可选）----
# 开启后后台把 relay.db 里新出现的请求错误发给所选小模型判断类型并给中文提示
ERROR_ANALYSIS_ENABLED=0
# ERROR_ANALYSIS_UPSTREAM=
# ERROR_ANALYSIS_MODEL=